# =================================================================
# Kairos AI — Environment variables (template)
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; NEVER commit real secrets.
#
# This single root file is the source of truth for all three services:
#   • frontend  (Vite — reads VITE_* via import.meta.env)
#   • backend/api (Express — reads via dotenv)
#   • backend/ml  (FastAPI — reads via pydantic-settings)
# There are no hardcoded fallbacks in code: every value below is required
# unless explicitly marked optional. Missing values fail startup with a
# clear error.
# =================================================================

# -----------------------------------------------------------------
# Frontend (Vite) — values prefixed with VITE_ are exposed to the
# browser bundle. Treat them as PUBLIC (never put secrets here).
# -----------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_BASE_URL=http://localhost:4000
VITE_ML_BASE_URL=http://localhost:8000
VITE_SOCKET_URL=ws://localhost:4000
VITE_APP_ENV=development

# LLM config surfaced to the UI (model selector). Provider + model list.
VITE_LLM_PROVIDER=groq
VITE_DEFAULT_MODEL=llama-3.3-70b-versatile
# Comma-separated. Each entry is `id` or `id|Human Label`.
# Add/remove/relabel here — the model selector updates with no code change.
VITE_AVAILABLE_MODELS=llama-3.1-8b-instant|Llama 3.1 8B,llama-3.3-70b-versatile|Llama 3.3 70B,openai/gpt-oss-120b|GPT-OSS 120B,openai/gpt-oss-20b|GPT-OSS 20B,openai/gpt-oss-safeguard-20b|GPT-OSS Safeguard 20B,qwen/qwen3-32b|Qwen 3 32B,groq/compound|Groq Compound,groq/compound-mini|Groq Compound Mini

# -----------------------------------------------------------------
# Shared / tooling
# -----------------------------------------------------------------
NODE_ENV=development
# Vite dev-server port (used by vite.config + the predev port cleaner).
WEB_PORT=5173

# -----------------------------------------------------------------
# Backend API (Express)
# -----------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ML_BASE_URL=http://localhost:8000
# Comma-separated list of browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
LOG_LEVEL=info

# Auth — Clerk
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: Clerk JWT public key (PEM). Leave blank to fetch via JWKS.
CLERK_JWT_KEY=

# Database — MongoDB
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?appName=kairos-cluster

# Code execution — Piston (public endpoint, no key needed)
PISTON_BASE_URL=https://emkc.org/api/v2/piston

# LLM (used by the API's test-case generator script)
LLM_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile
AVAILABLE_MODELS=llama-3.1-8b-instant|Llama 3.1 8B,llama-3.3-70b-versatile|Llama 3.3 70B,openai/gpt-oss-120b|GPT-OSS 120B,openai/gpt-oss-20b|GPT-OSS 20B,openai/gpt-oss-safeguard-20b|GPT-OSS Safeguard 20B,qwen/qwen3-32b|Qwen 3 32B,groq/compound|Groq Compound,groq/compound-mini|Groq Compound Mini

# Groq — the active brain (free tier): https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_me

# Secret for signing anonymous guest session tokens (HMAC). Use a long random string.
GUEST_TOKEN_SECRET=replace_me_with_a_long_random_secret

# -----------------------------------------------------------------
# ML service (backend/ml) — FastAPI coach, powered by Groq
# -----------------------------------------------------------------
ML_HOST=0.0.0.0
ML_PORT=8000
# Fallback model used automatically on HTTP 429 (must be in AVAILABLE_MODELS).
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
# Model-tuning constants (same across environments).
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048
