# =================================================================
# Kairos AI — Environment variables (template)
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.
# =================================================================

# -----------------------------------------------------------------
# Frontend (apps/web) — values prefixed with VITE_ are exposed to
# the browser bundle. Treat them as public.
# -----------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
VITE_API_BASE_URL=http://localhost:4000
VITE_ML_BASE_URL=http://localhost:8000
VITE_APP_ENV=development

# -----------------------------------------------------------------
# Backend (apps/api) — Express service
# -----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ML_BASE_URL=http://localhost:8000

# Auth — Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_JWT_KEY=

# Database — MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kairos?retryWrites=true&w=majority

# Code execution — Piston (public endpoint, no key needed)
PISTON_BASE_URL=https://emkc.org/api/v2/piston

# Logging
LOG_LEVEL=info

# -----------------------------------------------------------------
# ML service (apps/ml) — FastAPI + LangGraph
# -----------------------------------------------------------------
ML_PORT=8000
ML_HOST=0.0.0.0

# LLM provider — switch between providers via env
# Options: groq | hf_space | openai
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=2048

# Groq (Day 1 brain — free tier)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# HuggingFace (Week 3+ — your fine-tuned model)
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_USERNAME=your-username
HF_SPACE_URL=https://your-username-kairos-ai-dsa.hf.space

# OpenAI (optional fallback for hard cases)
OPENAI_API_KEY=

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
